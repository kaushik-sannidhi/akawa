# Cloudflare Calls (Realtime SFU) Configuration
# Required for WebRTC live streaming via Cloudflare SFU
#
# 1. Go to https://dash.cloudflare.com → Calls → Create App
# 2. Copy the App ID and App Secret
#
CF_APP_ID=your_cloudflare_calls_app_id
CF_APP_SECRET=your_cloudflare_calls_app_secret

# Cloudflare TURN Configuration
# Required for cross-network NAT traversal
#
# 1. Go to https://dash.cloudflare.com → Calls → TURN Keys
# 2. Create a key and copy the Key ID and API Token
#
CF_TURN_KEY_ID=your_cloudflare_turn_key_id
CF_TURN_API_TOKEN=your_cloudflare_turn_api_token

# Cloudflare Email Worker (already configured)
EMAIL_WORKER_URL=https://akawa-email-worker.kaushik-sannidhi.workers.dev/send
EMAIL_WORKER_SECRET=akawa-alerts-secret-key-2026

# CORS origins (comma-separated, optional — defaults are built-in)
# BACKEND_CORS_ORIGINS=http://localhost:3000,https://itsakawa.tech
